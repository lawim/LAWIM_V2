{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lawim.ai/schemas/expected-runtime-v1.json",
  "title": "Expected Runtime Schema",
  "description": "Comportement runtime attendu",
  "type": "object",
  "required": ["engine", "expected_services"],
  "properties": {
    "engine": {
      "type": "string",
      "enum": ["ConversationJourneyOrchestrator"],
      "description": "Moteur attendu pour traiter cette conversation"
    },
    "expected_services": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Services qui doivent etre invoques"
    },
    "expected_repositories": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Repositories qui doivent etre consultes"
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "description": "Timeout maximal attendu"
    },
    "retry_allowed": {
      "type": "boolean",
      "description": "Un retry est-il autorise en cas d'echec"
    },
    "fallback_chain": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Chaine de fallback attendue"
    }
  }
}
