{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LAWIM Gold Conversation",
  "type": "object",
  "required": ["id", "block", "turns", "assertions"],
  "properties": {
    "id": {"type": "string", "pattern": "^LAWIM-GOLD-B\\d{2}-\\d{4}$"},
    "block": {"type": "integer", "minimum": 1, "maximum": 10},
    "title": {"type": "string"},
    "category": {"type": "string"},
    "language": {"type": "string", "enum": ["fr", "en", "pcm", "mixed"]},
    "channel": {"type": "string", "enum": ["web", "telegram", "whatsapp", "cross_channel"]},
    "difficulty": {"type": "string", "enum": ["standard", "advanced", "expert"]},
    "turns": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["role", "text"],
        "properties": {
          "role": {"type": "string", "enum": ["user", "assistant", "system"]},
          "text": {"type": "string", "minLength": 1},
          "expected_state": {"type": "object"}
        }
      }
    },
    "expected_final_state": {"type": "object"},
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "expected"],
        "properties": {
          "type": {"type": "string"},
          "expected": {}
        }
      }
    }
  }
}
