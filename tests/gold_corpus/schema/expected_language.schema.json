{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lawim.ai/schemas/expected-language-v1.json",
  "title": "Expected Language Schema",
  "description": "Comportement linguistique attendu",
  "type": "object",
  "required": ["primary_language", "responses_language"],
  "properties": {
    "primary_language": {
      "type": "string",
      "enum": ["fr", "en", "pcm"],
      "description": "Langue principale de la conversation"
    },
    "responses_language": {
      "type": "string",
      "enum": ["fr", "en", "pcm"],
      "description": "Langue dans laquelle les reponses doivent etre formulees"
    },
    "allow_code_switch": {
      "type": "boolean",
      "description": "Le code-switching est-il autorise"
    },
    "forbidden_phrases": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Phrases interdites dans les reponses"
    },
    "footer_required": {
      "type": "boolean",
      "description": "Le footer IA est-il requis"
    },
    "identity": {
      "type": "string",
      "pattern": "LAWIM AI",
      "description": "Identite attendue de l'assistant"
    }
  }
}
