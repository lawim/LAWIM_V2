{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lawim.ai/schemas/conversation-v1.json",
  "title": "Gold Conversation Schema",
  "description": "Schema definitif d'une conversation Gold Corpus LAWIM",
  "type": "object",
  "required": [
    "id",
    "category",
    "level",
    "channel",
    "language",
    "messages",
    "description"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]\\d{6}$",
      "description": "Identifiant unique de la conversation (ex: B000001)"
    },
    "category": {
      "type": "string",
      "enum": [
        "purchase", "rental", "seller", "visit", "investment",
        "multilingual", "correction", "restart", "idempotence",
        "negotiation", "qualification", "marketplace", "followup",
        "edge_cases"
      ],
      "description": "Categorie fonctionnelle de la conversation"
    },
    "level": {
      "type": "string",
      "enum": ["basic", "intermediate", "advanced", "expert"],
      "description": "Niveau de difficulte"
    },
    "channel": {
      "type": "string",
      "enum": ["web", "telegram", "whatsapp", "api"],
      "description": "Canal source attendu"
    },
    "language": {
      "type": "string",
      "enum": ["fr", "en", "pcm"],
      "description": "Langue principale de la conversation"
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "text"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["user", "assistant"]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "intent": {
            "type": "string",
            "description": "Intention attendue apres ce message"
          }
        }
      }
    },
    "description": {
      "type": "string",
      "description": "Description en langage naturel du scenario"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Tags libres pour filtrage"
    },
    "business_object": {
      "type": "string",
      "description": "Type d'objet metier concerne (apartment, house, land, etc.)"
    }
  }
}
